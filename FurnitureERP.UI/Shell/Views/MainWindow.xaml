<Window x:Class="FurnitureERP.UI.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Furniture ERP"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <materialDesign:DialogHost Identifier="RootDialog">


        <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Sidebar -->

        <Border Background="#1E1E1E"
                Padding="10">

            <StackPanel>

                <Button Content="Dashboard"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenDashboardCommand}"/>

                <Button Content="Customers"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenCustomersCommand}"/>

                <Button Content="Products"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenProductsCommand}"/>

                <Button Content="Inventory"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenInventoryCommand}"/>

                <Button Content="Purchase Invoice"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenPurchaseInvoiceCommand}"/>

                <Button Content="Sales"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenSalesCommand}"/>

                <Button Content="Suppliers"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenSuppliersCommand}"/>

                <Button Content="Users"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenUsersCommand}"/>

                <Button Content="Reports"
                        Height="40"
                        Margin="0,5"
                        Command="{Binding OpenReportsCommand}"/>

                    <Button Content="Categories"
         Height="40"
         Margin="0,5"
         Command="{Binding OpenCategoriesCommand }"/>

                    <Button Content="Units"
Height="40"
Margin="0,5"
Command="{Binding OpenUnitsCommand }"/>



                </StackPanel>

        </Border>


        <!-- Main Content -->

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"/>


        <!-- Notification Overlay -->

        <Grid Grid.Column="1"
      Panel.ZIndex="999"
      IsHitTestVisible="False">

            <materialDesign:Snackbar
        Style="{StaticResource ERPSnackbar}"
        MessageQueue="{Binding SnackbarMessageQueue}"
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
                Margin="0,25,0,0"/>

        </Grid>
    </Grid>

    </materialDesign:DialogHost>
</Window>