<UserControl x:Class="FurnitureERP.UI.Common.Controls.Lookup.ERPAdvancedLookup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Label -->

        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="2,0,0,6">

            <StackPanel.Style>
                <Style TargetType="StackPanel">

                    <Setter Property="Visibility"
                    Value="Visible"/>

                    <Style.Triggers>

                        <DataTrigger
                    Binding="{Binding ShowLabel, ElementName=Root}"
                    Value="False">

                            <Setter Property="Visibility"
                            Value="Collapsed"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </StackPanel.Style>


            <TextBlock
            Text="{Binding Label, ElementName=Root}"
            FontWeight="SemiBold"/>

            <TextBlock
            Margin="2,0,0,0"
            Foreground="Red"
            Text="*">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                            Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger
                            Binding="{Binding IsRequired, ElementName=Root}"
                            Value="True">

                                <Setter Property="Visibility"
                                    Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

        <!-- Search -->

        <Grid Grid.Row="1">

            <TextBox x:Name="PART_SearchBox"
             Padding="12,8,36,8"
                     
             Text="{Binding SearchText,
                            ElementName=Root,
                            UpdateSourceTrigger=PropertyChanged}"
                     
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             materialDesign:HintAssist.Hint="{Binding Hint, ElementName=Root}"
             LostKeyboardFocus="SearchBox_LostKeyboardFocus"
             TextChanged="OnTextChanged"
             GotFocus="OpenPopup"
             PreviewKeyDown="OnKeyDown"/>
            
            <Grid HorizontalAlignment="Right"
      Width="32"
      Height="32"
      VerticalAlignment="Center"
      Margin="0,0,8,0">

                <Button Background="Transparent"
            BorderThickness="0"
            Focusable="False"
            Click="TogglePopup"/>

                <materialDesign:PackIcon Kind="MenuDown"
                             Width="20"
                             Height="20"
                             Foreground="Black"
                             IsHitTestVisible="False"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

            </Grid>
          
        </Grid>

        <!-- Popup -->

        <Popup IsOpen="{Binding IsPopupOpen, ElementName=Root}"
       PlacementTarget="{Binding ElementName=PART_SearchBox}"
       Placement="Bottom"
       AllowsTransparency="True"
       StaysOpen="True">

            <Border Width="{Binding ActualWidth, ElementName=Root}"
                    MaxHeight="350"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Results -->

                    <ListBox x:Name="PART_List"
                             Background="White"
                             SelectionMode="Single"
                             KeyboardNavigation.DirectionalNavigation="Continue"
                             PreviewKeyDown="PART_List_PreviewKeyDown"
                             Grid.Row="0"
                             BorderThickness="0"
                           
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding FilteredItems, ElementName=Root}"
                              SelectedItem="{Binding SelectedItem,
                                ElementName=Root,
                                Mode=TwoWay}"
                             ItemTemplate="{Binding ItemTemplate,
                                                    ElementName=Root}"
                            SelectionChanged="PART_List_SelectionChanged"/>

                    <!-- Create New -->

                    <Border Grid.Row="1"
                            Background="#F5F5F5"
                            Visibility="{Binding ShowAddButton,
                                                 ElementName=Root,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Button Height="42"
                                Focusable="False"
                                BorderThickness="0"
                                Background="Transparent"
                                Command="{Binding AddCommand, ElementName=Root}"
                                CommandParameter="{Binding SearchText, ElementName=Root}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <materialDesign:PackIcon Kind="PlusCircleOutline"
                                                         Width="18"
                                                         Height="18"/>

                                <TextBlock
    Margin="8,0,0,0"
    Text="{Binding EmptyText,
                   ElementName=Root}"/>

                            </StackPanel>

                        </Button>

                    </Border>

                </Grid>

            </Border>

        </Popup>
        
    </Grid>

</UserControl>