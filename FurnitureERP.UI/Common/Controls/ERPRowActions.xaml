<UserControl x:Class="FurnitureERP.UI.Common.Controls.ERPRowActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <StackPanel Orientation="Horizontal">

        <!-- View -->

        <Button
            Style="{StaticResource ERPGridIconButton}"
            Visibility="{Binding ShowView,
                         RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding ViewCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}">

            <materialDesign:PackIcon
                 Style="{StaticResource ERPGridActionIcon}"
                Kind="EyeOutline"
                Width="18"
                Height="18"/>

        </Button>

        <!-- Edit -->

        <Button
            Style="{StaticResource ERPGridIconButton}"
            Visibility="{Binding ShowEdit,
                         RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding EditCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}">

            <materialDesign:PackIcon
                Style="{StaticResource ERPGridActionIcon}"
                Kind="Pencil"
                Width="18"
                Height="18"/>

        </Button>

        <!-- Print -->

        <Button
            Style="{StaticResource ERPGridIconButton}"
            Visibility="{Binding ShowPrint,
                         RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding PrintCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}">

            <materialDesign:PackIcon
                Style="{StaticResource ERPGridActionIcon}"
                Kind="Printer"
                Width="18"
                Height="18"/>

        </Button>

        <!-- Delete -->

        <Button
            Style="{StaticResource ERPGridIconButton}"
            Visibility="{Binding ShowDelete,
                         RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding DeleteCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}">

            <materialDesign:PackIcon
                Style="{StaticResource ERPGridActionIcon}"
                Kind="DeleteOutline"
                Width="18"
                Height="18"
                Foreground="IndianRed"/>

        </Button>

    </StackPanel>

</UserControl>