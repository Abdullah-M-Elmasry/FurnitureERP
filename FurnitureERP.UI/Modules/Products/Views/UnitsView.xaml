<UserControl x:Class="FurnitureERP.UI.Modules.Products.Views.UnitsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls">

    <controls:ERPListPage
    Title="Units"
    Subtitle="Manage product units">

        <controls:ERPListPage.ToolbarContent>

            <controls:ERPToolbar>

                <controls:ERPToolbar.LeftContent>

                    <StackPanel Orientation="Horizontal">

                        <Button
                        Content="Add Unit"
                        Style="{StaticResource ERPPrimaryButton}"
                        Command="{Binding OpenAddUnitCommand}" />

                        <Button
                        Margin="8,0,0,0"
                        Content="Refresh"
                        Style="{StaticResource ERPSecondaryButton}"
                        Command="{Binding RefreshCommand}" />

                    </StackPanel>

                </controls:ERPToolbar.LeftContent>

                <controls:ERPToolbar.CenterContent>

                    <TextBox
                    Width="250"
                    materialDesign:HintAssist.Hint="Search..."
                    Text="{Binding SearchText,
                                   UpdateSourceTrigger=PropertyChanged}" />

                </controls:ERPToolbar.CenterContent>

            </controls:ERPToolbar>

        </controls:ERPListPage.ToolbarContent>

        <controls:ERPListPage.Content>

            <materialDesign:Card Padding="10">

                <DataGrid
                ItemsSource="{Binding Items}"
                AutoGenerateColumns="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                        Header="Code"
                        Binding="{Binding Code}" />

                        <DataGridTextColumn
                        Header="Name"
                        Width="*"
                        Binding="{Binding Name}" />

                        <DataGridCheckBoxColumn
                        Header="Active"
                        Binding="{Binding IsActive}" />

                        <DataGridTemplateColumn
                        Header="Actions"
                        Width="120">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <controls:ERPActionButtons
                                    Item="{Binding}"
                                    EditCommand="{Binding DataContext.EditUnitCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    DeleteCommand="{Binding DataContext.DeleteUnitCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </materialDesign:Card>

        </controls:ERPListPage.Content>

        <controls:ERPListPage.PaginationContent>

            <controls:ERPPagination
            CurrentPage="{Binding CurrentPage}"
            TotalPages="{Binding TotalPages}"
            PreviousCommand="{Binding PreviousPageCommand}"
            NextCommand="{Binding NextPageCommand}"
            FirstCommand="{Binding FirstPageCommand}"
            LastCommand="{Binding LastPageCommand}" />

        </controls:ERPListPage.PaginationContent>

    </controls:ERPListPage>
</UserControl>
