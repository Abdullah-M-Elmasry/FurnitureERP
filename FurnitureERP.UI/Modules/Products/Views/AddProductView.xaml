<UserControl x:Class="FurnitureERP.UI.Modules.Products.Views.AddProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls"
             xmlns:lookup="clr-namespace:FurnitureERP.UI.Common.Controls.Lookup"
             mc:Ignorable="d"
            >

    <controls:ERPFormLayout
        Width="650"
        Margin="10"
        Title="{Binding Title}"
        Subtitle="Enter product information"
        SaveButtonText="{Binding ButtonText}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelCommand}"
        ShowCancel="True">

        <controls:ERPFormLayout.FormContent>

            <StackPanel   Margin="5,16,5,0">

                <!-- Code -->
                <TextBox
                    Margin="0,0,0,2"
                    materialDesign:HintAssist.Hint="Code"
                    Text="{Binding Code,             
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" 
                    IsReadOnly="True"
                    Background="#F5F5F5"/>
                <TextBlock
    Text="{Binding CodeError}"
    Foreground="Red"
    FontSize="12"
    Margin="3,0,0,8"/>

                <!-- Barcode -->
                <TextBox
                    Margin="0,0,0,2"
                    materialDesign:HintAssist.Hint="Barcode"
                    Text="{Binding Barcode,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />
                <TextBlock
    Text="{Binding BarcodeError}"
    Foreground="Red"
    FontSize="12"
    Margin="3,0,0,8"/>

                <!-- Name -->
                <TextBox
                    Margin="0,0,0,2"
                    materialDesign:HintAssist.Hint="Product Name"
                    Text="{Binding Name,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />
                <TextBlock
    Text="{Binding NameError}"
    Foreground="Red"
    FontSize="12"
    Margin="3,0,0,8"/>

                <!-- Category -->
                <lookup:ERPAdvancedLookup
 Margin="0,0,0,15"
    Label="Category"

    ItemsSource="{Binding Categories}"

    SelectedItem="{Binding SelectedCategory}"
                    

    DisplayMemberPath="Name"

    SearchMemberPaths="Code,Name"

    AddCommand="{Binding AddCategoryCommand}"/>
                
                
                <!-- Unit -->
                <lookup:ERPAdvancedLookup
 Margin="0,0,0,15"
    Label="Unit"

    ItemsSource="{Binding Units}"

    SelectedItem="{Binding SelectedUnit , ValidatesOnNotifyDataErrors=True}"
                    

    DisplayMemberPath="Name"

    SearchMemberPaths="Code,Name"

    AddCommand="{Binding AddUnitCommand}" />

                <!-- Cost -->
                <TextBox
                    Margin="0,15,0,15"
                    materialDesign:HintAssist.Hint="Cost Price"
                    Text="{Binding CostPrice,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />

                <!-- Sale -->
                <TextBox
                    Margin="0,15,0,15"
                    materialDesign:HintAssist.Hint="Sale Price"
                    Text="{Binding SalePrice,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />

            </StackPanel>

        </controls:ERPFormLayout.FormContent>

    </controls:ERPFormLayout>

</UserControl>