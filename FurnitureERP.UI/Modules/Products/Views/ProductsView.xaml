<UserControl x:Class="FurnitureERP.UI.Modules.Products.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls">

    <controls:ERPListPage
        Title="Products"
        Subtitle="Manage products, prices and inventory">

        <!-- ================= TOOLBAR ================= -->

        <controls:ERPListPage.ToolbarContent>

            <controls:ERPToolbar>

                <controls:ERPToolbar.LeftContent>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Add Product"
                                Style="{StaticResource ERPPrimaryButton}"
                                Margin="0,0,8,0"
                                Command="{Binding OpenAddProductCommand}" />

                        <Button Content="Refresh"
                                Style="{StaticResource ERPSecondaryButton}"
                                Command="{Binding RefreshCommand}" />

                    </StackPanel>

                </controls:ERPToolbar.LeftContent>

                <controls:ERPToolbar.CenterContent>

                    <TextBox Width="250"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Search product..."
                             Text="{Binding SearchText,
                                            UpdateSourceTrigger=PropertyChanged}" />

                </controls:ERPToolbar.CenterContent>

            </controls:ERPToolbar>

        </controls:ERPListPage.ToolbarContent>


        <!-- ================= GRID ================= -->

        <controls:ERPListPage.Content>

            <materialDesign:Card
                Padding="10"
                UniformCornerRadius="8">

                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Code"
                            Binding="{Binding Code}" />

                        <DataGridTextColumn
                            Header="Barcode"
                            Binding="{Binding Barcode}" />

                        <DataGridTextColumn
                            Header="Name"
                            Width="2*"
                            Binding="{Binding Name}" />

                        <DataGridTextColumn
                            Header="Category"
                            Binding="{Binding Category.Name}" />

                        <DataGridTextColumn
                            Header="Unit"
                            Binding="{Binding Unit.Name}" />

                        <DataGridTextColumn
                            Header="Cost"
                            Binding="{Binding CostPrice}" />

                        <DataGridTextColumn
                            Header="Sale"
                            Binding="{Binding SalePrice}" />

                        <DataGridTemplateColumn
                            Header="Actions"
                            Width="120">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <controls:ERPActionButtons
                                        Item="{Binding}"
                                        EditCommand="{Binding DataContext.EditProductCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        DeleteCommand="{Binding DataContext.DeleteProductCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </materialDesign:Card>

        </controls:ERPListPage.Content>


        <!-- ================= PAGINATION ================= -->

        <controls:ERPListPage.PaginationContent>

            <controls:ERPPagination
                CurrentPage="{Binding CurrentPage}"
                TotalPages="{Binding TotalPages}"
                PreviousCommand="{Binding PreviousPageCommand}"
                NextCommand="{Binding NextPageCommand}"
                FirstCommand="{Binding FirstPageCommand}"
                LastCommand="{Binding LastPageCommand}" />

        </controls:ERPListPage.PaginationContent>

    </controls:ERPListPage>

</UserControl>