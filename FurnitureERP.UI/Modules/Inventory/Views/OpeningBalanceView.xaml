<UserControl x:Class="FurnitureERP.UI.Modules.Inventory.Views.OpeningBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls"
             xmlns:lookup="clr-namespace:FurnitureERP.UI.Common.Controls.Lookup"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <controls:ERPFormLayout
        Width="650"
        Margin="10"
        Title="{Binding Title}"
        Subtitle="Set opening balance for product"
        SaveButtonText="{Binding ButtonText}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelCommand}"
        ShowCancel="True">

        <controls:ERPFormLayout.FormContent>

            <StackPanel Margin="5,16,5,0">

                <!-- Product -->

                <lookup:ERPAdvancedLookup
                    Margin="0,0,0,15"
                    Label="Product"

                    ItemsSource="{Binding Products}"

                    SelectedItem="{Binding SelectedProduct,
                                           ValidatesOnNotifyDataErrors=True}"
                    AddCommand="{Binding AddProductCommand}"

                    DisplayMemberPath="Name"

                    SearchMemberPaths="Code,Name"/>

                <!-- Current Stock -->

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Current Stock"
                    Text="{Binding CurrentStock}"
                    IsReadOnly="True"
                    Background="#F5F5F5"/>

                <TextBlock
    Margin="2,-8,0,12"
    Foreground="#E65100"
    FontSize="12"
    Text="Opening Balance can only be set once."/>

                <!-- Opening Balance -->

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Opening Balance"
                    Text="{Binding Quantity,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />

                <!-- Notes -->

                <TextBox
                    Height="90"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    materialDesign:HintAssist.Hint="Notes"
                    Text="{Binding Notes}" />

            </StackPanel>

        </controls:ERPFormLayout.FormContent>

    </controls:ERPFormLayout>

</UserControl>