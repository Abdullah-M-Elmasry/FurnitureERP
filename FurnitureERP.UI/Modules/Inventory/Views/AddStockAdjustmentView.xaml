<UserControl x:Class="FurnitureERP.UI.Modules.Inventory.Views.AddStockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls"
             xmlns:lookup="clr-namespace:FurnitureERP.UI.Common.Controls.Lookup"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <controls:ERPFormLayout
        Width="650"
        Margin="10"
        Title="Stock Adjustment"
        Subtitle="Adjust product stock"
        SaveButtonText="Save"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelCommand}"
        ShowCancel="True">

        <controls:ERPFormLayout.FormContent>

            <StackPanel Margin="5,16,5,0">

                <!-- Product -->

                <lookup:ERPAdvancedLookup
                    Margin="0,0,0,15"
                    Label="Product"
                    ItemsSource="{Binding Products}"
                    SelectedItem="{Binding SelectedProduct}"
                    DisplayMemberPath="Name"
                    SearchMemberPaths="Code,Name"/>

                <!-- Current Stock -->

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Current Stock"
                    Text="{Binding CurrentStock}"
                    IsReadOnly="True"
                    Background="#F5F5F5"/>

                <!-- Quantity -->

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Quantity"
                    Text="{Binding Quantity,
                                   UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Reason -->

                <ComboBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Reason"
                    ItemsSource="{Binding Reasons}"
                    SelectedItem="{Binding SelectedReason}"/>

                <!-- Notes -->

                <TextBox
                    Height="90"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    materialDesign:HintAssist.Hint="Notes"
                    Text="{Binding Notes}"/>

            </StackPanel>

        </controls:ERPFormLayout.FormContent>

    </controls:ERPFormLayout>

</UserControl>