<UserControl x:Class="FurnitureERP.UI.Modules.Customers.Views.AddCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:FurnitureERP.UI.Common.Controls">

    <controls:ERPFormLayout
        Title="{Binding Title}"
        Subtitle="Enter customer information"
        SaveButtonText="{Binding ButtonText}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelCommand}"
        ShowCancel="True">

        <controls:ERPFormLayout.FormContent>

            <StackPanel>

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Customer Name"
                    Text="{Binding Name,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />
                <TextBlock
Text="{Binding NameError}"
Foreground="Red"
FontSize="12"
Margin="3,0,0,8"/>

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Phone"
                    Text="{Binding Phone,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />
                <TextBlock
Text="{Binding PhoneError}"
Foreground="Red"
FontSize="12"
Margin="3,0,0,8"/>

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Email"
                    Text="{Binding Email,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True}" />

                <TextBox
                    Margin="0,0,0,15"
                    materialDesign:HintAssist.Hint="Address"
                    Text="{Binding Address,
                                   UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Height="80"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    materialDesign:HintAssist.Hint="Notes"
                    Text="{Binding Notes,
                                   UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Margin="0,15,0,0"
                    Content="Active Customer"
                    IsChecked="{Binding IsActive}" />

            </StackPanel>

        </controls:ERPFormLayout.FormContent>

    </controls:ERPFormLayout>

</UserControl>